# Hugging Face API Token (required for downloading private models and uploading)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hugging Face Repository ID for uploading trained models
# Format: username/model-name
HF_REPO_ID=your-username/your-model-name

# Base model to fine-tune
# Examples: meta-llama/Llama-3.2-1B, Qwen/Qwen2.5-0.5B
MODEL_NAME=meta-llama/Llama-3.2-1B

# Output directory for trained adapters and checkpoints
OUTPUT_DIR=outputs

# Training configuration (optional overrides)
# LEARNING_RATE=1e-4
# BATCH_SIZE=4
# NUM_EPOCHS=3
# LORA_RANK=8
# LORA_ALPHA=16

# Open Router API (optional - faster than local Qwen for data preparation)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-0.6b-04-28
